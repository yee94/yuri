<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yee94.yuri.nsh">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- camera.scan (QR pairing), voice input recognition and local notifications. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Yuri Hosts are often plain HTTP on a trusted LAN, like the iOS ATS exception. -->
    <application
        android:name=".YuriApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/YuriTheme"
        android:usesCleartextTraffic="true">
        <!-- @yuri-associated-domains: build-android.mjs injects
             com.yee94.yuri.nsh.associatedDomains from YURI_WEBCREDENTIALS_DOMAINS. -->

        <!-- resources.present action "share": read-only content URIs, no AndroidX FileProvider. -->
        <provider
            android:name=".ResourceShareProvider"
            android:authorities="com.yee94.yuri.nsh.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <meta-data
            android:name="com.yee94.yuri.nsh.files"
            android:value="com.yee94.yuri.nsh.ResourceShareProvider" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yuri" android:host="connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
