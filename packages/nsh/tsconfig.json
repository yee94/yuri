{
  "extends": "./.nsh/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "nsh": ["./.nsh/types/nsh/index.d.ts"],
      "nsh/*": ["./.nsh/types/nsh/*.d.ts"],
      "*": ["./.nsh/types/*.d.ts"],
      "@/*": ["../ui/src/*"]
    }
  },
  "include": ["*.ts", "*.tsx", "../ui/src/types/desktop.d.ts"],
  "exclude": ["*.test.ts", "*.test.tsx", "vitest.config.ts", "tests", "gui-plugin-entry.ts", "gui-plugin-factory.ts"]
}
