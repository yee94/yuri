{
  "name": "Yuri Native",
  "id": "com.yee94.yuri.nsh",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "theme": "theme.json",
  "capabilities": {
    "clipboard": true,
    "picker": true,
    "speech": true,
    "openUrl": { "schemes": ["https", "http", "mailto"] },
    "host": [
      "connection.list",
      "connection.editor",
      "connection.rename",
      "connection.edit",
      "native.clientMetadata",
      "native.diagnostics.status",
      "native.diagnostics.setEnabled",
      "native.diagnostics.append",
      "native.diagnostics.export",
      "notification.status",
      "notification.request",
      "notification.openSettings",
      "notification.configure",
      "notification.live",
      "notification.test",
      "notification.launch.peek",
      "notification.launch.claim",
      "notification.launch.ack",
      "connection.connect",
      "connection.select",
      "connection.remove",
      "runtime.request",
      "runtime.stream",
      "runtime.stop",
      "runtime.pickAttachment",
      "resources.read",
      "resources.present",
      "resources.release",
      "resources.cancel",
      "resources.close",
      "resources.web.present",
      "resources.web.close",
      "speech.prepare",
      "speech.segment",
      "speech.stop",
      "speech.release",
      "speech.awake",
      "voiceRecognition.capabilities",
      "voiceRecognition.start",
      "voiceRecognition.finish",
      "voiceRecognition.cancel",
      "appearance.reset",
      "appearance.apply",
      "navigation.anchor",
      "schedule.dateContext",
      "remoteDesktop.open",
      "remoteDesktop.close",
      "remoteDesktop.input",
      "remoteDesktop.view",
      "remoteDesktop.ack",
      "terminal.capabilities",
      "terminal.discovery.file",
      "terminal.discovery.port",
      "terminal.catalog.read",
      "terminal.catalog.write",
      "terminal.restore",
      "terminal.probe",
      "terminal.create",
      "terminal.attach",
      "terminal.detach",
      "terminal.input",
      "terminal.resize",
      "terminal.close",
      "terminal.forceKill",
      "terminal.preview.open",
      "terminal.preview.render",
      "terminal.preview.finish",
      "camera.scan"
    ]
  }
}
