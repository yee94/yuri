{
  "name": "Yuri Dev",
  "id": "com.yee94.yuri.nsh.dev",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "theme": "../theme.json",
  "capabilities": {
    "clipboard": true,
    "openUrl": { "schemes": ["https", "http", "mailto"] },
    "host": [
      "connection.list",
      "connection.select",
      "connection.remove",
      "connection.connect",
      "camera.scan",
      "runtime.request",
      "runtime.stream",
      "runtime.stop",
      "runtime.pickAttachment",
      "runtime.cancelAttachment",
      "runtime.reconcileAttachment",
      "runtime.acknowledgeAttachment",
      "runtime.pendingAttachments"
    ]
  }
}
