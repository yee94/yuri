     /// What a platform view does with `command`, as far as the model
     /// keeps it.
+    fn clamp_scroll(&mut self, id: NodeId) {
+        let end = self.scroll_end(id);
+        if let Some(scroll) = self.scroll_mut(id) {
+            let offset = if scroll.horizontal { &mut scroll.x } else { &mut scroll.y };
+            let next = (*offset).clamp(Points::ZERO, end);
+            if *offset != next {
+                *offset = next;
+                self.scrolled.push(id);
+            }
+        }
+    }
