+    #[test]
+    fn clamped_index_pin_survives_late_visible_body_growth_until_user_scroll() {
+        let mut l = list(40, 64.0, 830.0);
+        for i in 0..40 {
+            l.measured(i, 64.0);
+        }
+        let target = PinTarget::Index { index: 39, view_position: 0.0, view_offset: 0.0 };
+        let at = l.target_offset(target);
+        l.pin(Some(target), at, false);
+        l.jump(at);
+        assert_eq!(l.follow_pin(0.0), Follow::Stay);
+        assert!(l.pinned(), "the requested index alignment is still clamped by the content end");
+        for i in 28..40 {
+            let anchor = l.measured(i, 80.0);
+            l.offset += anchor;
+            l.follow_pin(anchor);
+            assert!(l.item_at(39) + l.row_extent(39) <= l.offset + l.viewport);
+        }
+        let user_at = l.offset - 100.0;
+        l.reported(user_at, 0);
+        assert!(!l.pinned());
+        l.measured(38, 120.0);
+        assert_eq!(l.follow_pin(0.0), Follow::Stay);
+        assert_eq!(l.offset, user_at);
+    }
