+#[test]
+fn the_64_mib_limit_accepts_its_boundary_rejects_overflow_and_recovers() {
+    let server = DevServer::start("127.0.0.1:0".parse().unwrap(), "bc-1", None, |_| {}).unwrap();
+    let limit = 64 << 20;
+    server.publish(
+        vec![0x5a; limit],
+        "source".into(),
+        None,
+        AppInfo::default(),
+        None,
+        Vec::new(),
+    );
+    let url = format!("ws://{}{WS_PATH}", server.local_addr());
+    let (tx, rx) = mpsc::channel();
+    let _client = DevClient::start(url, host("bounded-bundle-test", "bc-1"), move |e| {
+        let _ = tx.send(e);
+    })
+    .unwrap();
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT).unwrap(),
+        DevEvent::Connected
+    ));
+    match rx.recv_timeout(TIMEOUT).unwrap() {
+        DevEvent::Bundle {
+            version: 1, bytes, ..
+        } => {
+            assert_eq!(bytes.len(), limit);
+            assert!(bytes.iter().all(|&byte| byte == 0x5a));
+        }
+        other => panic!("exactly 64 MiB was not delivered: {other:?}"),
+    }
+    server.publish(
+        vec![0x5a; limit + 1],
+        "source".into(),
+        None,
+        AppInfo::default(),
+        None,
+        Vec::new(),
+    );
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT).unwrap(),
+        DevEvent::Disconnected
+    ));
+    server.publish(
+        vec![1, 2, 3],
+        "small source".into(),
+        None,
+        AppInfo::default(),
+        None,
+        Vec::new(),
+    );
+    match next_non_status(&rx) {
+        DevEvent::Bundle {
+            version: 3, bytes, ..
+        } => assert_eq!(bytes, [1, 2, 3]),
+        other => panic!("small bundle after reconnect was not delivered: {other:?}"),
+    }
+}
