+#[test]
+fn the_default_socket_rejects_a_bundle_above_16_mib() {
+    use nsh_dev::protocol::{ClientMessage, PROTOCOL_VERSION, ServerMessage};
+    use tungstenite::{Message, error::CapacityError, stream::MaybeTlsStream};
+
+    let server = DevServer::start("127.0.0.1:0".parse().unwrap(), "bc-1", None, |_| {}).unwrap();
+    let size = 17 << 20;
+    server.publish(
+        vec![0x5a; size],
+        "source".into(),
+        None,
+        AppInfo::default(),
+        None,
+        Vec::new(),
+    );
+    let (mut socket, _) =
+        tungstenite::connect(format!("ws://{}{WS_PATH}", server.local_addr())).unwrap();
+    if let MaybeTlsStream::Plain(stream) = socket.get_mut() {
+        stream.set_read_timeout(Some(TIMEOUT)).unwrap();
+        stream.set_write_timeout(Some(TIMEOUT)).unwrap();
+    }
+    let hello = ClientMessage::Hello {
+        protocol: PROTOCOL_VERSION,
+        bytecode_version: "bc-1".into(),
+        device: "default-frame-limit-test".into(),
+        platform: Some(HostPlatform::MacOs),
+        ui_sets: Some(Vec::new()),
+        tests: false,
+    };
+    socket
+        .send(Message::Text(serde_json::to_string(&hello).unwrap().into()))
+        .unwrap();
+    for is_bundle in [false, true] {
+        let Message::Text(text) = socket.read().unwrap() else {
+            panic!("expected the protocol announcement");
+        };
+        let message: ServerMessage = serde_json::from_str(&text).unwrap();
+        assert_eq!(matches!(message, ServerMessage::Bundle { .. }), is_bundle);
+    }
+    assert!(matches!(
+        socket.read(),
+        Err(tungstenite::Error::Capacity(CapacityError::MessageTooLong {
+            size: actual,
+            max_size,
+        })) if actual == size && max_size == 16 << 20
+    ));
+}
