+#[test]
+fn a_large_bundle_round_trips_through_a_redirect() {
+    let server = DevServer::start("127.0.0.1:0".parse().unwrap(), "bc-1", None, |_| {}).unwrap();
+    let size = 17 << 20;
+    server.publish(
+        vec![0x5a; size],
+        "source".into(),
+        Some("{\"version\":3}".into()),
+        AppInfo::default(),
+        None,
+        Vec::new(),
+    );
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("ws://{}{WS_PATH}", listener.local_addr().unwrap());
+    let destination = format!("ws://{}{WS_PATH}", server.local_addr());
+    let redirect = std::thread::spawn(move || {
+        let (stream, _) = listener.accept().unwrap();
+        stream.set_read_timeout(Some(TIMEOUT)).unwrap();
+        stream.set_write_timeout(Some(TIMEOUT)).unwrap();
+        let result =
+            tungstenite::accept_hdr(stream, |_: &tungstenite::handshake::server::Request, _| {
+                Err(tungstenite::http::Response::builder()
+                    .status(307)
+                    .header("Location", destination)
+                    .body(None)
+                    .unwrap())
+            });
+        assert!(matches!(
+            result,
+            Err(tungstenite::HandshakeError::Failure(tungstenite::Error::Http(response)))
+                if response.status() == 307
+        ));
+    });
+    let (tx, rx) = mpsc::channel();
+    let _client = DevClient::start(url, host("large-bundle-test", "bc-1"), move |e| {
+        let _ = tx.send(e);
+    })
+    .unwrap();
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT).unwrap(),
+        DevEvent::Connected
+    ));
+    match rx.recv_timeout(TIMEOUT).unwrap() {
+        DevEvent::Bundle {
+            version: 1,
+            format: BundleFormat::Bytecode,
+            bytes,
+            source_map,
+            ..
+        } => {
+            assert_eq!(bytes.len(), size);
+            assert!(bytes.iter().all(|&byte| byte == 0x5a));
+            assert_eq!(source_map.as_deref(), Some("{\"version\":3}"));
+        }
+        other => panic!("large bundle was not delivered: {other:?}"),
+    }
+    redirect.join().unwrap();
+}
