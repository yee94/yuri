+    #[test]
+    fn a_clamped_index_pin_follows_until_its_row_enters_the_viewport() {
+        let mut l = in_page(0.0, 0.0, 800.0);
+        l.pin(
+            Some(PinTarget::Index {
+                index: 40,
+                view_position: 0.0,
+                view_offset: 0.0,
+            }),
+            0.0,
+            false,
+        );
+        assert_eq!(l.follow_pin(0.0), Follow::By(800.0));
+        assert_eq!(l.offset, 800.0);
+        for i in 0..30 {
+            assert_eq!(l.measured(i, 50.0), 0.0);
+        }
+        assert_eq!(l.follow_pin(0.0), Follow::Stay);
+        assert!(l.pinned(), "row 40 is still below the clamped page");
+        l.set_outer(0.0, 800.0, 400.0, 5000.0, true);
+        assert_eq!(l.follow_pin(0.0), Follow::By(1200.0));
+        assert_eq!(l.offset, 2000.0);
+        assert!(l.pinned(), "the target row is not measured yet");
+        for i in 40..50 {
+            assert_eq!(l.measured(i, 50.0), 0.0);
+        }
+        assert_eq!(l.follow_pin(0.0), Follow::Stay);
+        assert!(!l.pinned(), "the requested alignment now fits");
+    }
