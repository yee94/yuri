+import { List, Text, View, mount, signal, type ListRef } from 'nsh';
+
+const rows = signal([0]), shown = signal(true), inverted = signal(true);
+const snapshot = signal('unread'), scrolls = signal(0), starts = signal(0), ends = signal(0);
+const dimensions = signal({ width: 320, height: 300 });
+let list: ListRef;
+async function read() { snapshot.set(JSON.stringify(await list.getScrollSnapshot())); }
+mount(() => <View>
+  {shown() && <List ref={value => { list = value; }} testID="list" each={rows()} inverted={inverted()}
+    style={dimensions()} estimatedItemSize={40}
+    onScroll={() => scrolls.update(value => value + 1)}
+    onLoadMore={() => ends.update(value => value + 1)}
+    onLoadMoreAtStart={() => starts.update(value => value + 1)}>
+    {row => <View style={{ height: 40 }}><Text>{'row-' + row()}</Text></View>}
+  </List>}
+  <View testID="read" onPress={() => { void read(); }}><Text>Read</Text></View>
+  <View testID="tall" onPress={() => rows.set(Array.from({ length: 30 }, (_, index) => index))}><Text>Tall</Text></View>
+  <View testID="normal" onPress={() => inverted.set(false)}><Text>Normal</Text></View>
+  <View testID="resize-list" onPress={() => dimensions.set({ width: 240, height: 220 })}><Text>Resize List</Text></View>
+  <View testID="remove-read" onPress={() => { const pending = list.getScrollSnapshot(); shown.set(false); void pending.then(value => snapshot.set(JSON.stringify(value))); }}><Text>Remove pending</Text></View>
+  <Text>{'snapshot:' + snapshot()}</Text>
+  <Text>{'events:' + [scrolls(), starts(), ends()].join(',')}</Text>
+</View>);
