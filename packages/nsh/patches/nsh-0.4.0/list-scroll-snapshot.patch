+//! Private native replies, including late/absent refs and physical-point units.
+use super::*;
+use crate::{
+    JsonValue, ScrollSnapshot,
+    element::{Environment, json_host::JsonHost},
+    platform::Os,
+};
+
+fn fixture() -> Core<FakeEngine> {
+    let mut c = core();
+    c.set_environment(Environment {
+        os: Os::MacOs,
+        pixel_ratio: 2.5,
+        ..Environment::default()
+    });
+    apply(
+        &mut c,
+        vec![
+            Op::Create {
+                id: 2,
+                tag: Tag::List,
+            },
+            style_op(
+                2,
+                &[
+                    ("width", StyleValue::Number(320.0)),
+                    ("height", StyleValue::Number(300.0)),
+                ],
+            ),
+            Op::SetProp {
+                id: 2,
+                prop: Prop::Count(30),
+            },
+            Op::SetProp {
+                id: 2,
+                prop: Prop::Inverted(true),
+            },
+            Op::SetProp {
+                id: 2,
+                prop: Prop::EstimatedItemSize(px(40.0)),
+            },
+            Op::Insert {
+                parent: ROOT_ID,
+                child: 2,
+                before: None,
+            },
+        ],
+    );
+    c.commit();
+    c.events.clear();
+    c
+}
+
+fn native(c: &Core<FakeEngine>) -> ScrollSnapshot {
+    let node = &c.nodes[c.key(2).unwrap() as usize];
+    ScrollSnapshot {
+        offset: point(px(0.0), px(37.5)),
+        content_size: node.scroll.as_ref().unwrap().content.unwrap(),
+        size: node.frame.size,
+        zoom_scale: 1.0,
+    }
+}
+
+fn reply(c: &mut Core<FakeEngine>, call: u32) -> JsonValue {
+    let host = JsonHost::default();
+    let at = c.events.iter().position(|event| matches!(event, crate::element::JsEvent::Reply { call: current, .. } if *current == call)).expect("reply");
+    let crate::element::JsEvent::Reply { result, .. } = c.events.remove(at) else {
+        unreachable!()
+    };
+    host.read(result.unwrap().to_js_value(&host).unwrap())
+        .unwrap()
+}
+
+#[test]
+fn list_scroll_snapshot_uses_native_points_not_core_defaults_replay_or_pixel_ratio() {
+    let mut c = fixture();
+    let mut actual = native(&c);
+    let key = c.key(2).unwrap();
+    c.nodes[key as usize]
+        .list
+        .as_mut()
+        .unwrap()
+        .issue_scroll_to(1234.0);
+    assert!(c.begin_scroll_snapshot(2, 40));
+    actual.offset.y = px(19.25);
+    assert!(c.component_event(
+        ROOT_ID,
+        EventKind::ScrollSnapshot,
+        &ScrollSnapshot::reply(40, Some(actual))
+    ));
+    let value = reply(&mut c, 40);
+    assert_eq!(value["offset"]["y"], 19.25);
+    assert_eq!(value["size"]["width"], 320.0);
+    assert_eq!(value["size"]["height"], 300.0);
+    assert!(
+        !c.nodes[key as usize].list.as_ref().unwrap().settled(),
+        "read cannot apply or replay scrolls"
+    );
+    assert!(c.scroll_snapshot_calls.is_empty());
+}
+
+#[test]
+fn list_scroll_snapshot_keeps_zoomed_content_and_unscaled_viewport() {
+    let mut c = fixture();
+    let mut actual = native(&c);
+    assert!(c.begin_scroll_snapshot(2, 41));
+    actual.zoom_scale = 2.0;
+    actual.content_size = actual.content_size * 2.0;
+    c.answer_scroll_snapshot(&ScrollSnapshot::reply(41, Some(actual)));
+    let value = reply(&mut c, 41);
+    assert_eq!(value["contentSize"]["width"], 640.0);
+    assert_eq!(value["size"]["width"], 320.0);
+    assert_eq!(value["zoomScale"], 2.0);
+}
+
+#[test]
+fn list_scroll_snapshot_rejects_late_resize_content_and_detach_replies() {
+    for change in ["resize", "content", "detach", "release"] {
+        let mut c = fixture();
+        let actual = native(&c);
+        assert!(c.begin_scroll_snapshot(2, 42));
+        match change {
+            "resize" => c
+                .apply(style_op(2, &[("height", StyleValue::Number(220.0))]))
+                .unwrap(),
+            "content" => c
+                .apply(Op::SetProp {
+                    id: 2,
+                    prop: Prop::Count(100),
+                })
+                .unwrap(),
+            "detach" => c
+                .apply(Op::Remove {
+                    parent: ROOT_ID,
+                    child: 2,
+                })
+                .unwrap(),
+            "release" => c.apply(Op::Release { id: 2 }).unwrap(),
+            _ => unreachable!(),
+        }
+        c.commit();
+        c.answer_scroll_snapshot(&ScrollSnapshot::reply(42, Some(actual)));
+        assert_eq!(reply(&mut c, 42), JsonValue::Null, "{change}");
+        assert!(c.scroll_snapshot_calls.is_empty());
+    }
+}
+
+#[test]
+fn list_scroll_snapshot_invalid_and_wrong_sized_native_frames_are_null() {
+    for change in ["nan", "infinite", "zero", "wrong-size", "wrong-content"] {
+        let mut c = fixture();
+        let mut actual = native(&c);
+        assert!(c.begin_scroll_snapshot(2, 43));
+        match change {
+            "nan" => actual.offset.y = px(f32::NAN),
+            "infinite" => actual.content_size.height = px(f32::INFINITY),
+            "zero" => actual.size.height = px(0.0),
+            "wrong-size" => actual.size.height = px(200.0),
+            "wrong-content" => actual.content_size.height = px(1000.0),
+            _ => unreachable!(),
+        }
+        c.answer_scroll_snapshot(&ScrollSnapshot::reply(43, Some(actual)));
+        assert_eq!(reply(&mut c, 43), JsonValue::Null, "{change}");
+    }
+}
+
+#[test]
+fn list_scroll_snapshot_detach_settles_before_native_reply_and_cannot_revive_after_reattach() {
+    let mut c = fixture();
+    let actual = native(&c);
+    assert!(c.begin_scroll_snapshot(2, 46));
+    c.apply(Op::Remove {
+        parent: ROOT_ID,
+        child: 2,
+    })
+    .unwrap();
+    assert_eq!(reply(&mut c, 46), JsonValue::Null);
+    assert!(c.scroll_snapshot_calls.is_empty());
+    c.apply(Op::Insert {
+        parent: ROOT_ID,
+        child: 2,
+        before: None,
+    })
+    .unwrap();
+    c.commit();
+    c.answer_scroll_snapshot(&ScrollSnapshot::reply(46, Some(actual)));
+    assert!(
+        !c.events
+            .iter()
+            .any(|event| matches!(event, crate::element::JsEvent::Reply { call: 46, .. }))
+    );
+}
+
+#[test]
+fn list_scroll_snapshot_absent_unsupported_and_duplicate_replies_do_not_hang_or_raise_scroll_events()
+ {
+    let mut c = fixture();
+    assert!(!c.begin_scroll_snapshot(999, 44));
+    assert_eq!(reply(&mut c, 44), JsonValue::Null);
+    assert!(c.begin_scroll_snapshot(2, 47));
+    c.answer_scroll_snapshot(&ScrollSnapshot::reply(47, None));
+    assert_eq!(reply(&mut c, 47), JsonValue::Null);
+    c.components.environment.os = Os::Ios;
+    assert!(!c.begin_scroll_snapshot(2, 45));
+    assert_eq!(reply(&mut c, 45), JsonValue::Null);
+    c.answer_scroll_snapshot(&ScrollSnapshot::reply(45, None));
+    assert!(
+        !c.events
+            .iter()
+            .any(|event| matches!(event, crate::element::JsEvent::Reply { call: 45, .. }))
+    );
+    assert!(c.scroll_snapshot_calls.is_empty());
+}
