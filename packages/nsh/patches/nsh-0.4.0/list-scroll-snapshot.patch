+import { expect, open, test } from 'nsh/test';
+
+const value = app => JSON.parse(app.texts().find(text => text.startsWith('snapshot:')).slice(9));
+const events = app => app.texts().find(text => text.startsWith('events:'));
+for (const platform of ['macos', 'windows']) {
+  test(platform + ' read-only initial actual short inverted snapshot, resize and cleanup', async () => {
+    const app = await open('./App.tsx', { platform, width: 400, height: 600, clock: {} });
+    await app.waitFor('id:list');
+    const before = events(app);
+    await app.press('id:read');
+    await app.waitUntil(() => !app.texts().includes('snapshot:unread'));
+    expect(value(app)).toEqual({ offset: { x: 0, y: 0 }, contentSize: { width: 320, height: 300 }, size: { width: 320, height: 300 }, zoomScale: 1 });
+    for (let index = 0; index < 50; index++) await app.press('id:read');
+    expect(events(app)).toBe(before);
+    await app.setViewport(500, 700); await app.press('id:read');
+    expect(value(app).size).toEqual({ width: 320, height: 300 });
+    await app.press('id:resize-list'); await app.press('id:read');
+    expect(value(app)).toEqual({ offset: { x: 0, y: 0 }, contentSize: { width: 240, height: 220 }, size: { width: 240, height: 220 }, zoomScale: 1 });
+    await app.press('id:normal'); await app.press('id:read');
+    expect(value(app)).toEqual({ offset: { x: 0, y: 0 }, contentSize: { width: 240, height: 40 }, size: { width: 240, height: 220 }, zoomScale: 1 });
+    await app.press('id:remove-read');
+    await app.waitUntil(() => app.texts().includes('snapshot:null'));
+    await app.press('id:read'); expect(value(app)).toBeNull();
+    expect(app.requests()).toEqual([]);
+  });
+  test(platform + ' actual physical offset follows long normal and inverted scrolls without read side effects', async () => {
+    const app = await open('./App.tsx', { platform, width: 400, height: 600, clock: {} });
+    await app.press('id:tall'); await app.scroll('id:list', -200);
+    await app.press('id:read');
+    const inverted = value(app);
+    expect(inverted.contentSize.height).toBe(1200);
+    expect(inverted.offset.y).toBe(700);
+    const before = events(app); await app.press('id:read'); expect(events(app)).toBe(before);
+    await app.press('id:normal'); await app.scroll('id:list', -200); await app.press('id:read');
+    expect(value(app).offset.y).toBe(500);
+    expect(value(app).size.height).toBe(300);
+    expect(app.requests()).toEqual([]);
+  });
+}
