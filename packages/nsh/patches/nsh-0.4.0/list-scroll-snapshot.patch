+//! Explicit, read-only List snapshots from the platform's live scroll owner.
+//! Never replay a pending core scroll or raise a scroll/pagination event.
+
+use super::{Core, Key, Kind};
+use crate::{EventPayload, JsonValue, NodeId, Point, Points, Size, platform::Os, text::TextEngine};
+
+/// A platform's actual scroll frame, in points, with the same coordinates as `onScroll`.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ScrollSnapshot {
+    /// Actual platform-reported physical offset, not a core replay target.
+    pub offset: Point<Points>,
+    /// Actual content extent, zoomed as in `onScroll`.
+    pub content_size: Size<Points>,
+    /// Native viewport extent in points.
+    pub size: Size<Points>,
+    /// Native zoom scale; macOS and Windows currently support only one.
+    pub zoom_scale: f32,
+}
+
+impl ScrollSnapshot {
+    fn valid(&self) -> bool {
+        let values = [
+            self.offset.x.0,
+            self.offset.y.0,
+            self.content_size.width.0,
+            self.content_size.height.0,
+            self.size.width.0,
+            self.size.height.0,
+            self.zoom_scale,
+        ];
+        values.iter().all(|value| value.is_finite()) && values[2..].iter().all(|value| *value > 0.0)
+    }
+
+    fn json(self) -> JsonValue {
+        serde_json::json!({
+            "offset": { "x": self.offset.x.0, "y": self.offset.y.0 },
+            "contentSize": { "width": self.content_size.width.0, "height": self.content_size.height.0 },
+            "size": { "width": self.size.width.0, "height": self.size.height.0 },
+            "zoomScale": self.zoom_scale,
+        })
+    }
+
+    /// The private platform reply; it is not an `onScroll` event.
+    pub fn reply(call: u32, snapshot: Option<Self>) -> EventPayload {
+        EventPayload::Json(serde_json::json!({
+            "call": call,
+            "snapshot": snapshot.filter(Self::valid).map(Self::json),
+        }))
+    }
+
+    fn parse(value: &JsonValue) -> Option<Self> {
+        let number = |field: &str, member: &str| {
+            value
+                .get(field)?
+                .get(member)?
+                .as_f64()
+                .map(|v| Points(v as f32))
+        };
+        let result = Self {
+            offset: Point::new(number("offset", "x")?, number("offset", "y")?),
+            content_size: Size::new(
+                number("contentSize", "width")?,
+                number("contentSize", "height")?,
+            ),
+            size: Size::new(number("size", "width")?, number("size", "height")?),
+            zoom_scale: value.get("zoomScale")?.as_f64()? as f32,
+        };
+        result.valid().then_some(result)
+    }
+}
+
+pub(super) struct PendingSnapshot {
+    node: NodeId,
+    size: Size<Points>,
+    content: Size<Points>,
+}
+
+impl<M: TextEngine> Core<M> {
+    pub(super) fn cancel_scroll_snapshots(&mut self, subtree: Key) {
+        let calls: Vec<_> = self
+            .scroll_snapshot_calls
+            .iter()
+            .filter_map(|(&call, pending)| {
+                self.key(pending.node)
+                    .ok()
+                    .filter(|&key| self.is_ancestor(subtree, key))
+                    .map(|_| call)
+            })
+            .collect();
+        for call in calls {
+            self.scroll_snapshot_calls.remove(&call);
+            self.settle(call, Ok(Box::new(JsonValue::Null)));
+        }
+    }
+
+    fn snapshot_target(&self, id: NodeId) -> Option<(Size<Points>, Size<Points>)> {
+        if !matches!(self.components.environment.os, Os::MacOs | Os::Windows) {
+            return None;
+        }
+        let key = self.key(id).ok()?;
+        let node = &self.nodes[key as usize];
+        if node.kind != Kind::List
+            || !node.created
+            || node.layout.is_none()
+            || !self.in_tree(key)
+            || node.list.as_ref()?.parent
+        {
+            return None;
+        }
+        Some((node.frame.size, node.scroll.as_ref()?.content?))
+    }
+
+    pub(super) fn begin_scroll_snapshot(&mut self, id: NodeId, call: u32) -> bool {
+        let Some((size, content)) = self.snapshot_target(id) else {
+            self.settle(call, Ok(Box::new(JsonValue::Null)));
+            return false;
+        };
+        self.scroll_snapshot_calls.insert(
+            call,
+            PendingSnapshot {
+                node: id,
+                size,
+                content,
+            },
+        );
+        true
+    }
+
+    pub(super) fn answer_scroll_snapshot(&mut self, payload: &EventPayload) {
+        let EventPayload::Json(value) = payload else {
+            return;
+        };
+        let Some(call) = value
+            .get("call")
+            .and_then(JsonValue::as_u64)
+            .and_then(|n| u32::try_from(n).ok())
+        else {
+            return;
+        };
+        let Some(pending) = self.scroll_snapshot_calls.remove(&call) else {
+            return;
+        };
+        let snapshot = value
+            .get("snapshot")
+            .and_then(ScrollSnapshot::parse)
+            .filter(|snapshot| {
+                self.snapshot_target(pending.node) == Some((pending.size, pending.content))
+                    && snapshot.size == pending.size
+                    && snapshot.content_size == pending.content * snapshot.zoom_scale
+            });
+        self.settle(
+            call,
+            Ok(Box::new(
+                snapshot.map_or(JsonValue::Null, ScrollSnapshot::json),
+            )),
+        );
+    }
+}
