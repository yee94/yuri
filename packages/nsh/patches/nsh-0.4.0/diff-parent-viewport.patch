+                let target = st
+                    .model
+                    .hunks
+                    .len()
+                    .checked_sub(1)
+                    .and_then(|i| crate::diff::layout::hunk_row(&st.rows, i))
+                    .map(|r| st.geometry.top(r).0)
+                    .unwrap_or_default();
+                READ.with(|r| {
+                    *r.borrow_mut() = Readout {
