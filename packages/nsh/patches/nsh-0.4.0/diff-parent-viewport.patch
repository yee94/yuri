+    let source = (0..p.count)
+        .map(|i| format!("line {i} {}", "abcdefgh ".repeat(12)))
+        .collect::<Vec<_>>();
+    let old = source.join("\n");
+    let mut source = source;
+    source[10] = "changed first".into();
+    source[p.count - 5] = "changed last".into();
+    let new = source.join("\n");
+    let api = move |f: &dyn Fn(&DiffViewApi)| {
+        f(&dv.api::<DiffViewApi>().expect("mounted diff"));
+    };
+    let button = move |id: &'static str, f: Box<dyn Fn(&DiffViewApi)>| {
+        view().test_id(id).h(px(1.0)).on_press(move || api(&*f))
+    };
+    let mut el = diff_view()
+        .viewport(p.viewport)
+        .layout(move || layout.get())
+        .soft_wrap(move || wrap.get())
+        .expand_all(move || all.get())
+        .old_value(old)
+        .new_value(new)
+        .component_ref(&dv);
+    if p.viewport == DiffViewport::Own {
+        el = el.h(px(400.0));
+    }
+    let el = el.into_element();
+    let body = if p.list {
+        let held = RefCell::new(Some(el));
+        nsh_core::element::virtual_list(1usize, move |_| {
+            view().child(view().flex_none().h(px(100.0))).child(
+                held.borrow_mut()
+                    .take()
+                    .expect("the single List row stays mounted"),
+            )
+        })
+        .test_id("outer")
+        .w(relative(1.0))
+        .h(px(400.0))
+        .footer(view().h(px(200.0)))
+        .into_element()
+    } else {
+        scroll()
+            .test_id("outer")
+            .w(relative(1.0))
+            .h(px(400.0))
+            .child(view().flex_none().h(px(100.0)))
+            .child(el)
+            .child(view().flex_none().h(px(200.0)))
+            .into_element()
+    };
+    view()
+        .child(body)
+        .child(button(
+            "inspect",
+            Box::new(move |a| {
+                let d = &a.dv;
