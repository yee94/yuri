+#[test]
+fn parent_rows_follow_actual_ancestor_offset_with_bounded_nodes_and_complete_copy() {
+    for os in [Os::MacOs, Os::Windows] {
+        for layout in [DiffLayout::Split, DiffLayout::Unified] {
+            let mut counts = Vec::new();
+            for count in [400, 12000] {
+                let (mut c, ids, items) = start(count, layout, DiffViewport::Parent, os);
+                let initial = read(&mut c, &ids);
+                assert_eq!(initial.offset, -100.0);
+                assert_eq!(initial.viewport, 400.0);
+                assert!(initial.height >= count as f32 * 20.0);
+                assert!(initial.range.len() < 100);
+                assert!(c.node_count() < 2000, "{}", c.node_count());
+                let creates = items
+                    .iter()
+                    .filter(|i| matches!(i, MountItem::Create { .. }))
+                    .count();
+                assert!(creates < 2000, "{creates}");
+                counts.push((creates, items.len()));
+                assert!(items.iter().any(|i| matches!(i, MountItem::Create { id, kind: ViewKind::View } if *id == initial.vertical)));
+                c.set_scroll_offset(ids["outer"], point(px(0.0), px(2100.0)), 0);
+                settle(&mut c);
+                let moved = read(&mut c, &ids);
+                assert_eq!(moved.offset, 2000.0);
+                assert!(
+                    moved.range.start >= 70 && moved.range.end < 160,
+                    "{moved:?}"
+                );
+                press(&mut c, &ids, "copy");
+                let copied = read(&mut c, &ids);
+                assert!(copied.copied.ends_with(&format!(
+                    "line {} {}",
+                    count - 1,
+                    "abcdefgh ".repeat(12)
+                )));
+                let command = press(&mut c, &ids, "end");
+                assert!(command.iter().any(|i| matches!(i, MountItem::Command { id, command: nsh_core::Command::ScrollTo { .. } } if *id == ids["outer"])));
+                let end = read(&mut c, &ids);
+                assert!(end.range.end >= count - 1);
+                assert_eq!(end.selected, copied.selected);
+                assert!(c.node_count() < 2000);
+            }
+            assert!(counts[1].0 <= counts[0].0 + 12, "{counts:?}");
+            assert!(counts[1].1 <= counts[0].1 + 64, "{counts:?}");
+        }
+    }
+}
