+                    DiffSide::New,
+                    true,
+                    false,
+                    true,
+                );
+                a.dv.line_drag_to(point(px(5.0), px(450.0)));
+                a.dv.parent_drag_scroll();
+            }),
+        ))
+        .child(button("release", Box::new(|a| a.dv.line_release(false))))
+}
+
+type TestCore = Core<ApproxTextEngine>;
+
+fn settle(c: &mut TestCore) -> Vec<MountItem> {
+    let mut items = Vec::new();
+    for _ in 0..20 {
+        if let Some(batch) = c.commit() {
+            items.extend(batch.items);
+        }
+        let mut events = Vec::new();
+        c.take_events(&mut events);
+        if events.is_empty() {
+            break;
+        }
+        for event in events {
+            match event {
+                JsEvent::LayoutListener {
+                    host,
+                    id,
+                    listener,
+                    frame,
+                } => c.component_layout(host, id, &listener, frame),
+                JsEvent::Event(id, kind, payload) => {
+                    c.component_event(id, kind, &payload);
+                }
+                _ => {}
+            }
+        }
+    }
+    items
+}
+
+fn start(
+    count: usize,
+    layout: DiffLayout,
+    viewport: DiffViewport,
+    os: Os,
+) -> (TestCore, HashMap<String, NodeId>, Vec<MountItem>) {
+    start_with_list(count, layout, viewport, os, false)
+}
+
+fn start_with_list(
+    count: usize,
+    layout: DiffLayout,
+    viewport: DiffViewport,
+    os: Os,
+    list: bool,
+) -> (TestCore, HashMap<String, NodeId>, Vec<MountItem>) {
+    let mut c = Core::new(ApproxTextEngine, size(px(800.0), px(600.0)));
+    c.set_environment(nsh_core::element::Environment {
+        os,
+        idiom: Idiom::Desktop,
+        ..Default::default()
+    });
+    c.mount_root(&Root::new::<Fixture>(move || FixtureProps {
+        count,
+        layout,
+        viewport,
+        list,
+    }));
+    let items = settle(&mut c);
+    let ids = items
+        .iter()
+        .filter_map(|i| match i {
+            MountItem::ViewProps { id, props } => {
+                props.test_id.as_ref().map(|name| (name.to_string(), *id))
+            }
+            _ => None,
+        })
+        .collect();
+    (c, ids, items)
+}
+
+fn press(c: &mut TestCore, ids: &HashMap<String, NodeId>, id: &str) -> Vec<MountItem> {
+    assert!(c.component_event(ids[id], EventKind::Press, &EventPayload::None));
+    settle(c)
+}
+
+fn read(c: &mut TestCore, ids: &HashMap<String, NodeId>) -> Readout {
+    press(c, ids, "inspect");
+    READ.with(|r| r.borrow().clone())
+}
