+                        range: d.visible_rows(),
+                        selected: a.selected_lines(),
+                        copied: a.selected_text(),
+                        hunk: d.current_hunk(),
+                        target,
+                        vertical: d.vscroll.node().unwrap(),
+                        horizontal: d.hscroll.map(|h| h.node().unwrap_or(0)),
+                    }
+                });
+            }),
+        ))
+        .child(button(
+            "end",
+            Box::new(|a| a.set_scroll_offset(point(px(0.0), px(1e9)))),
+        ))
+        .child(button(
+            "target",
+            Box::new(|a| a.go_to_hunk(a.hunks().len() as u32 - 1)),
+        ))
+        .child(button(
+            "copy",
+            Box::new(|a| {
+                let mut range = DiffLineRange::default();
+                range.side = DiffSide::New;
+                range.end = u32::MAX;
+                a.set_selected_lines(Some(range));
+            }),
+        ))
+        .child(button(
+            "wrap",
+            Box::new(move |_| wrap.set(!wrap.get_untracked())),
+        ))
+        .child(button(
+            "collapse",
+            Box::new(move |_| all.set(!all.get_untracked())),
+        ))
+        .child(button(
+            "separator",
+            Box::new(|a| a.expand(1, Some(crate::DiffExpand::All), None)),
+        ))
+        .child(button(
+            "layout",
+            Box::new(move |_| {
+                layout.set(if layout.get_untracked() == DiffLayout::Split {
