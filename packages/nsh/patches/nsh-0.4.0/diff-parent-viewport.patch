+//! Parent viewport vertical slice, on the actual Rust component and core.
+use std::{cell::RefCell, collections::HashMap, ops::Range};
+
+use super::*;
+use crate::{DiffLayout, DiffView, DiffViewApi, DiffViewport, diff_view};
+use nsh_core::{
+    ApproxTextEngine, Core, EventKind, EventPayload, MountItem, NodeId, ViewKind,
+    element::{JsEvent, Root},
+    platform::{Idiom, Os},
+};
