+#[test]
+fn parent_resize_wrap_collapse_target_and_split_scroll_keep_selection() {
+    for os in [Os::MacOs, Os::Windows] {
+        let (mut c, ids, _) = start(400, DiffLayout::Split, DiffViewport::Parent, os);
+        press(&mut c, &ids, "copy");
+        let selected = read(&mut c, &ids).selected;
+        press(&mut c, &ids, "wrap");
+        c.set_viewport(size(px(500.0), px(600.0)));
+        settle(&mut c);
+        let wrapped = read(&mut c, &ids);
+        assert!(wrapped.height > 8000.0);
+        assert_eq!(wrapped.selected, selected);
+        press(&mut c, &ids, "collapse");
+        let collapsed = read(&mut c, &ids);
+        assert!(collapsed.height < wrapped.height);
+        assert_eq!(collapsed.selected, selected);
+        press(&mut c, &ids, "separator");
+        let expanded = read(&mut c, &ids);
+        assert!(expanded.height > collapsed.height);
+        assert_eq!(expanded.selected, selected);
+        press(&mut c, &ids, "collapse");
+        let command = press(&mut c, &ids, "target");
+        assert!(
+            command
+                .iter()
+                .any(|i| matches!(i, MountItem::Command { id, .. } if *id == ids["outer"]))
+        );
+        let target = read(&mut c, &ids);
+        assert_eq!(target.hunk, Some(1));
+        assert!((target.offset - target.target).abs() < 1.0, "{target:?}");
+        assert_eq!(target.selected, selected);
+        press(&mut c, &ids, "wrap");
+        let sides = read(&mut c, &ids).horizontal;
+        let horizontal = press(&mut c, &ids, "horizontal");
+        assert!(horizontal.iter().any(|i| matches!(i, MountItem::Command { id, command: nsh_core::Command::ScrollTo { x, .. } } if *id == sides[1] && x.0 == 70.0)));
+        press(&mut c, &ids, "layout");
+        assert_eq!(read(&mut c, &ids).selected, selected);
+    }
+}
