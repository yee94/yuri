+#[derive(Default, Clone, Debug)]
+struct Readout {
+    offset: f32,
+    height: f32,
+    viewport: f32,
+    range: Range<usize>,
+    selected: Option<DiffLineRange>,
+    copied: String,
+    hunk: Option<usize>,
+    target: f32,
+    vertical: NodeId,
+    horizontal: [NodeId; 2],
+}
+
+thread_local! { static READ: RefCell<Readout> = RefCell::default(); }
