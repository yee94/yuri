+//! Win32 routing tests. These require Windows, but open no native window.
+
+use super::*;
+use crate::{geom::rect, text_input};
+use nsh_core::keymap::{KeyBinding, Keymap, Keystroke, When};
+use nsh_core::platform::Os;
+
+fn surface() -> Rc<Surface> {
+    let mut env = nsh_core::platform::Environment::default();
+    env.reduce_motion = true;
+    let surface = Surface::new(env);
+    surface.without_shader_renderer();
+    surface
+}
+
+fn stop(parent: &NshView, id: NodeId) -> NshView {
+    let view = NshView::new(id, ViewKind::View);
+    view.state_mut().frame = rect(0.0, 0.0, 100.0, 30.0);
+    for kind in [
+        EventKind::PressDown,
+        EventKind::PressUp,
+        EventKind::Press,
+        EventKind::Focus,
+        EventKind::Blur,
+    ] {
+        view.state_mut().events.set(kind, true);
+    }
+    view.insert_before(parent, None);
+    view
+}
+
+fn down(vk: u16) -> KeyEvent {
+    KeyEvent {
+        vk,
+        down: true,
+        repeat: false,
+        modifiers: Modifiers::default(),
+    }
+}
+
+fn events(surface: &Surface, kind: EventKind) -> Vec<NodeId> {
+    surface
+        .focus_test_events
+        .borrow()
+        .iter()
+        .filter_map(|(id, event)| (*event == kind).then_some(*id))
+        .collect()
+}
+
+#[test]
+fn windows_stops_share_generic_gates_and_tree_order() {
+    let surface = surface();
+    let button = stop(&surface.root, 2);
+    let role = stop(&surface.root, 4);
+    role.state_mut().props.accessibility.role = nsh_core::AccessibilityRole::Button;
+    let chart = stop(&surface.root, 6);
+    chart.state_mut().events.set(EventKind::Press, false);
+    chart.state_mut().props.focusable = Some(true);
+    let excluded = stop(&surface.root, 8);
+    excluded.state_mut().props.accessibility.accessible = Some(false);
+    let disabled_parent = stop(&surface.root, 10);
+    disabled_parent
+        .state_mut()
+        .props
+        .accessibility
+        .state
+        .disabled = true;
+    stop(&disabled_parent, 12);
+    let hidden_parent = stop(&surface.root, 14);
+    hidden_parent.state_mut().style.hidden = true;
+    stop(&hidden_parent, 16);
+    let ax_parent = stop(&surface.root, 18);
+    ax_parent.state_mut().props.accessibility.hidden = true;
+    stop(&ax_parent, 20);
+    let opt_out = stop(&surface.root, 22);
+    opt_out.state_mut().props.focusable = Some(false);
+    let pointer_parent = stop(&surface.root, 24);
+    pointer_parent.state_mut().props.pointer_events = PointerEvents::None;
+    stop(&pointer_parent, 26);
+    let concealed_parent = stop(&surface.root, 28);
+    concealed_parent.state_mut().concealed = true;
+    stop(&concealed_parent, 30);
+    let mut stops = Vec::new();
+    collect_stops(&surface.root, &mut stops);
+    assert_eq!(stops, [button, role, chart]);
+}
+
+#[test]
+fn windows_tab_and_reverse_wrap_share_the_input_owner() {
+    let surface = surface();
+    let button = stop(&surface.root, 2);
+    let role = stop(&surface.root, 4);
+    role.state_mut().props.accessibility.role = nsh_core::AccessibilityRole::Button;
+    let field = NshView::new(6, ViewKind::Input);
+    field.insert_before(&surface.root, None);
+    text_input::create(&surface, &field);
+    assert!(key(&surface, down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(button.clone()));
+    assert!(text_input::focused(&surface).is_none());
+    assert!(key(&surface, down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(role.clone()));
+    assert!(key(&surface, down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(field.clone()));
+    assert_eq!(text_input::focused(&surface), Some(field.clone()));
+    assert!(key(&surface, down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(button.clone()));
+    let mut reverse = down(VK_TAB);
+    reverse.modifiers.shift = true;
+    assert!(key(&surface, reverse));
+    assert_eq!(text_input::owner(&surface), Some(field));
+    assert!(key(&surface, reverse));
+    assert_eq!(text_input::owner(&surface), Some(role));
+    text_input::blur(&button);
+    assert!(
+        text_input::owner(&surface).is_some(),
+        "non-owner blur is isolated"
+    );
+}
+
+#[test]
+fn windows_enter_space_activate_once_without_repeating_or_scrolling() {
+    let surface = surface();
+    let scroll = NshView::new(2, ViewKind::Scroll);
+    scroll.state_mut().frame = rect(0.0, 0.0, 100.0, 100.0);
+    scroll.insert_before(&surface.root, None);
+    let button = stop(&scroll, 4);
+    stop(&scroll, 6);
+    text_input::focus_view(&surface, &button);
+    for vk in [0x0D, 0x20] {
+        assert!(key(&surface, down(vk)));
+        assert!(key(
+            &surface,
+            KeyEvent {
+                repeat: true,
+                ..down(vk)
+            }
+        ));
+        key(
+            &surface,
+            KeyEvent {
+                down: false,
+                ..down(vk)
+            },
+        );
+    }
+    assert_eq!(events(&surface, EventKind::Press), [4, 4]);
+    assert_eq!(events(&surface, EventKind::PressDown), [4, 4]);
+    assert_eq!(events(&surface, EventKind::PressUp), [4, 4]);
+    assert_eq!(scroll.state().scroll.as_ref().unwrap().y, Points::ZERO);
+    for modifiers in [
+        Modifiers {
+            shift: true,
+            ..Default::default()
+        },
+        Modifiers {
+            ctrl: true,
+            ..Default::default()
+        },
+        Modifiers {
+            alt: true,
+            ..Default::default()
+        },
+        Modifiers {
+            meta: true,
+            ..Default::default()
+        },
+    ] {
+        assert!(!activate_key(
+            &surface,
+            &KeyEvent {
+                modifiers,
+                ..down(0x0D)
+            }
+        ));
+    }
+    assert_eq!(events(&surface, EventKind::Press), [4, 4]);
+}
+
+#[test]
+fn windows_keymap_precedes_activation_and_inactive_windows_keep_only_ownership() {
+    let surface = surface();
+    let button = stop(&surface.root, 2);
+    text_input::focus_view(&surface, &button);
+    let binding = KeyBinding::new(
+        77,
+        Keystroke::parse("enter", Os::Windows).unwrap(),
+        When::Always,
+        false,
+    );
+    crate::keymap::set(&surface, std::sync::Arc::new(Keymap::new(vec![binding])));
+    assert!(key(&surface, down(0x0D)));
+    assert_eq!(events(&surface, EventKind::KeyCommand), [ROOT_ID]);
+    assert!(events(&surface, EventKind::Press).is_empty());
+    crate::keymap::clear(&surface);
+    text_input::window_focus(&surface, false);
+    assert!(!activate_key(&surface, &down(0x20)));
+    assert!(!tab(&surface, &down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(button));
+    text_input::window_focus(&surface, true);
+    assert!(key(&surface, down(0x20)));
+    assert_eq!(events(&surface, EventKind::Press), [2]);
+}
+
+#[test]
+fn windows_modal_traps_and_restores_the_same_generic_owner() {
+    let surface = surface();
+    let button = stop(&surface.root, 2);
+    text_input::focus_view(&surface, &button);
+    let modal = NshView::new(4, ViewKind::Modal);
+    let inside = stop(&modal, 6);
+    crate::navigation::present(&surface, &modal);
+    assert!(text_input::owner(&surface).is_none());
+    assert!(!in_focus_scope(&surface, &button));
+    assert!(key(&surface, down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(inside.clone()));
+    assert!(key(&surface, down(VK_TAB)));
+    assert_eq!(text_input::owner(&surface), Some(inside));
+    crate::navigation::dismiss(&surface, &modal);
+    assert_eq!(text_input::owner(&surface), Some(button));
+}
+
+#[test]
+fn windows_dynamic_exclusion_detach_and_stop_drop_focus() {
+    let surface = surface();
+    let button = stop(&surface.root, 2);
+    text_input::focus_view(&surface, &button);
+    button.state_mut().props.accessibility.state.disabled = true;
+    reconcile_focus(&surface);
+    assert!(text_input::owner(&surface).is_none());
+    button.state_mut().props.accessibility.state.disabled = false;
+    text_input::focus_view(&surface, &button);
+    button.unparent();
+    assert!(text_input::owner(&surface).is_none());
+    button.insert_before(&surface.root, None);
+    text_input::focus_view(&surface, &button);
+    surface.stop();
+    assert!(text_input::owner(&surface).is_none());
+}
