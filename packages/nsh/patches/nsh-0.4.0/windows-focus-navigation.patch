+/// Whether the view and its ancestors admit keyboard interaction.
+fn key_reachable(view: &NshView) -> bool {
+    if !view.attached() {
+        return false;
+    }
+    let mut current = Some(view.clone());
+    while let Some(view) = current {
+        let s = view.state();
+        if s.style.hidden
+            || s.concealed
+            || s.props.pointer_events == PointerEvents::None
+            || s.props.accessibility.state.disabled
+            || s.props.accessibility.hidden
+            || s.live.as_ref().is_some_and(|l| l.dying())
+        {
+            return false;
+        }
+        drop(s);
+        current = view.parent_view();
+    }
+    true
+}
