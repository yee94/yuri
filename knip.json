{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.{test,spec}.{js,cjs,mjs,jsx,ts,tsx}",
        "src/lib/gui-plugins/native.electron.fixture.ts",
        "src/sync/fixtures/remote-projects-indexeddb-renderer.ts",
        "src/**/__tests__/**/*.{js,cjs,mjs,jsx,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/web": {
      "entry": [
        "src/mobile-main.tsx",
        "src/mini-chat-main.tsx",
        "src/sw.ts",
        "server/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}",
        "server/lib/gui-customization/*-client.mjs",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": [
        "bin/**/*.js",
        "server/**/*.{js,mjs,cjs}",
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/relay-server": {
      "entry": [
        "bin/yuri-relay.js",
        "bin/yuri-push-relay.js",
        "src/index.js",
        "src/index.d.ts",
        "src/worker.js",
        "src/push/index.js",
        "src/push/index.d.ts",
        "test/node-smoke.js",
        "test/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
      ],
      "project": [
        "bin/**/*.js",
        "src/**/*.{js,ts}",
        "test/**/*.js"
      ]
    },
    "packages/electron": {
      "entry": [
        "main.mjs",
        "preload.mjs",
        "remote-desktop-preload.cjs",
        "remote-desktop-capture.mjs",
        "tray.mjs",
        "ssh-manager.mjs",
        "opencode-cwd.mjs",
        "*.{test,spec}.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ],
      "project": [
        "*.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ]
    },
    "packages/nsh": {
      "entry": ["App.tsx", "*.test.ts", "scripts/*.mjs", "tests/**/*.{js,mjs}"],
      "project": ["*.{ts,tsx}", "scripts/*.mjs", "tests/**/*.{js,mjs}"],
      "ignoreDependencies": ["nsh"]
    },
    "packages/vscode": {
      "entry": [
        "src/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}",
        "webview/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "webview/**/*.{ts,tsx}"
      ]
    }
  }
}
