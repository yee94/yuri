{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remote Projects raw performance evidence (not a gate pass)",
  "type": "object",
  "required": ["schemaVersion", "phase", "runtime", "device", "os", "runtimeVersion", "build", "datasetHash", "command", "measurement", "gate", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"enum": ["baseline", "candidate"]},
    "runtime": {"enum": ["counter", "electron", "ios", "production-hub", "browser-diagnostic"]},
    "production": {"type": "boolean"},
    "device": {"type": "string", "minLength": 1},
    "os": {"type": "string", "minLength": 1},
    "runtimeVersion": {"type": "string", "minLength": 1},
    "build": {"type": "string", "minLength": 1},
    "datasetHash": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "measurement": {"type": "string", "minLength": 1},
    "gate": {"type": "integer", "minimum": 1, "maximum": 25},
    "status": {"enum": ["measured", "unverified", "blocked"]},
    "reason": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metrics": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["unit", "samples"],
        "properties": {
          "unit": {"type": "string", "minLength": 1},
          "samples": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"required": ["metrics", "artifacts"]}, "else": {"required": ["reason"]}},
    {"if": {"properties": {"runtime": {"not": {"const": "counter"}}}}, "then": {"required": ["production"], "properties": {"production": {"const": true}}}}
  ]
}
