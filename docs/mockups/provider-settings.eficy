.pv-model-toolbar{padding:12px 14px 8px}.pv-model-toolbar .pv-search input{border-color:transparent;background:color-mix(in srgb,var(--surface-foreground) 3%,var(--surface-elevated))}.pv-filters{display:flex;align-items:center;gap:3px;margin-top:10px;flex-wrap:wrap}.pv .pv-filters .pv-chip{height:25px;min-height:25px;font-size:11px;padding:0 8px;font-weight:400}.pv-model-columns{display:grid;grid-template-columns:minmax(0,1fr) 85px 120px 30px;gap:10px;padding:7px 14px;font-size:10px;line-height:17px;color:var(--surface-muted-foreground)}.pv-model-columns>span:nth-child(3){text-align:right}.pv-model-columns>span:last-child{text-align:center}.pv-model-item{border-top:1px solid var(--form-row-divider)}.pv-model-row{display:grid;grid-template-columns:minmax(0,1fr) 85px 120px 30px;gap:10px;align-items:center;padding:10px 14px;min-height:64px}.pv-model-name{min-width:0;border:0;background:transparent;color:var(--surface-foreground);display:flex;align-items:center;gap:8px;text-align:left;padding:0;font-size:13px}.pv-model-name:hover>span:first-child{color:var(--interactive-selection-foreground)}.pv-model-name>span{min-width:0;overflow-wrap:anywhere;line-height:20px}.pv-model-name>svg{color:var(--surface-muted-foreground);opacity:0;transition:transform .12s,opacity .12s}.pv-model-name:hover>svg,.pv-model-name:focus-visible>svg,.pv-model-name[aria-expanded=true]>svg{opacity:1}.pv-model-name code{display:block;font-size:10px;line-height:16px;color:var(--surface-muted-foreground)}.pv-capabilities{display:flex;align-items:center;gap:8px;color:var(--surface-muted-foreground);font-size:11px}.pv-capabilities>span{display:inline-flex;align-items:center;gap:4px}.pv-capabilities-full{gap:16px;flex-wrap:wrap}.pv-token-count{text-align:right;font-size:11px;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--surface-foreground)}.pv-token-count>span{color:var(--surface-muted-foreground)}.pv-model-hidden .pv-model-name,.pv-model-hidden .pv-capabilities,.pv-model-hidden .pv-to