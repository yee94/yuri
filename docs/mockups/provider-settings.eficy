.pv-page-header{margin-bottom:5px}.pv-page-header>.pv-helper{margin-top:5px}.pv-action-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.pv-action-header .pv-helper{margin-top:5px}.pv-header-actions{display:flex;align-items:center;gap:5px;flex-wrap:wrap;justify-content:flex-end}.pv-custom-choice{display:flex;align-items:center;text-align:left;gap:16px;padding:22px;border:1px solid var(--form-surface-border);border-radius:var(--yuri-settings-group-radius);background:var(--yuri-settings-group-background);color:var(--surface-foreground);width:100%}.pv-custom-choice:hover{background:var(--interactive-hover)}.pv-choice-symbol{width:42px;display:grid;place-items:center;color:var(--surface-muted-foreground);flex-shrink:0}.pv-custom-choice>span:nth-child(2){flex:1;min-width:0}.pv-custom-choice strong{font-size:15px;font-weight:500}.pv-custom-choice p{font-size:12px;color:var(--surface-muted-foreground);margin:4px 0 8px}.pv-custom-choice .pv-helper{font-size:11px}.pv-custom-choice>svg{color:var(--surface-muted-foreground)}.pv-provider-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.pv-provider-choice{display:flex;align-items:center;gap:11px;background:transparent;border:0;padding:18px 16px;text-align:left;color:var(--surface-foreground);min-width:0}.pv-provider-choice:hover{background:var(--interactive-hover)}.pv-provider-choice:nth-child(odd){border-right:1px solid var(--form-row-divider)}.pv-provider-choice:nth-child(n+3){border-top:1px solid var(--form-row-divider)}.pv-provider-choice>span:nth-child(2){flex:1;min-width:0;font-size:13px}.pv-provider-choice small{display:block;font-size:11px;color:var(--surface-muted-foreground);margin-top:3px}.pv-provider-choice>svg{color:var(--surface-muted-foreground)}.pv-address{display:flex;flex-direction:column;align-items:stretch;gap:9px;font-size:14px}.pv-address input{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}.pv-route-preview{display:flex;flex-direct