@media(max-width:680px){.pv-managed-row{gap:6px;padding-inline:10px}.pv-managed-name{font-size:12px}.pv-managed-row>.pv-capabilities{gap:3px}.pv-managed-row>.pv-capabilities>span{padding:4px;min-width:20px}.pv-model-actions{gap:0}.pv-managed-toolbar>select{width:96px}.pv.pv-model-dialog{padding:20px;width:calc(100vw - 24px);max-height:calc(100dvh - 32px)}.pv-model-dialog .pv-row{grid-template-columns:82px minmax(0,1fr);gap:8px}.pv-model-dialog .pv-sync-row>.pv-capabilities{display:none}.pv-sync-toolbar{flex-wrap:wrap}.pv-sync-toolbar>.pv-search{flex-basis:100%}.pv-dialog-footer .pv-button,.pv-dialog-footer .pv-quiet{min-height:36px}.pv-sync-scroll{max-height:42dvh}}
.pv-model-toolbar-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0;flex-wrap:wrap}.pv .pv-model-toolbar-actions>.pv-button{font-size:11px;font-weight:400}.pv .pv-flat-model-list{max-height:420px;overflow-y:auto;scrollbar-gutter:stable}.pv-flat-model-list>.pv-managed-row+.pv-managed-row{border-top:1px solid var(--form-row-divider)}.pv-model-available .pv-managed-name{color:var(--surface-muted-foreground)}.pv-model-available .pv-model-actions{min-width:63px;justify-content:flex-end}.pv .pv-plus-action:hover{color:var(--surface-foreground);background:var(--interactive-hover)}.pv-model-discovery-error{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--status-error);padding:0 5px}.pv-list-limit{padding:0 5px;font-size:11px!important}.pv .pv-sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.pv-discovery-spinner{animation:pv-discover-spin 1s linear infinite}.pv-phone .pv-managed-heading{flex-wrap:wrap;gap:8px}.pv-phone .pv-model-toolbar-actions{margin-left:auto;gap:6px}.pv-phone .pv-model-available .pv-model-actions{min-width:72px}.pv-phone .pv-flat-model-list{max-height:380px}@keyframes pv-discover-spin{to{transform:rotate(360deg)}}
@media(max-width:680px){.pv-managed-heading{flex-wrap:wrap;gap:8px}.pv-model-toolbar-actions{margin-left:auto;gap:6px}.pv-model-available .pv-model-actions{min-width:72px}.pv .pv-flat-model-list{max-height:380px}}
@media(prefers-reduced-motion:reduce){.pv *{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
`;

