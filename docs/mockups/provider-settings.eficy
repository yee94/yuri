ground);overflow-wrap:anywhere}.pv-managed-name:hover{color:var(--interactive-selection-foreground);text-decoration:underline;text-decoration-color:var(--form-surface-border);text-underline-offset:4px}.pv-managed-row>.pv-capabilities{flex-shrink:0;gap:5px}.pv-managed-row>.pv-capabilities>span{padding:4px 7px;min-width:26px;justify-content:center;border-radius:999px;background:color-mix(in srgb,var(--surface-foreground) 4%,transparent)}.pv-model-actions{display:flex;align-items:center;gap:3px;flex-shrink:0}.pv .pv-minus-action:hover{background:var(--status-error-background);color:var(--status-error)}.pv-model-membership-note{padding:0 5px;font-size:11px!important}.pv-model-undo{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 6px;font-size:12px;color:var(--surface-muted-foreground)}
.pv.pv-model-dialog{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;gap:20px;width:min(600px,calc(100vw - 32px));max-width:600px;min-height:0;max-height:calc(100dvh - 48px);overflow-y:auto;margin:0;padding:24px;border-radius:var(--yuri-settings-group-radius);border:1px solid var(--form-surface-border);background:var(--surface-background);color:var(--surface-foreground);box-shadow:0 20px 65px color-mix(in srgb,var(--surface-background) 50%,transparent);z-index:60}.pv-model-dialog .pv-dialog-header{display:flex;flex-direction:column;gap:6px;text-align:left;padding-right:26px}.pv-model-dialog .pv-dialog-header h2{font-size:16px;line-height:24px;font-weight:600}.pv-model-dialog .pv-dialog-header .pv-helper{font-size:11px;line-height:18px}.pv-model-dialog-form{display:flex;flex-direction:column;gap:18px}.pv-model-dialog .pv-row{grid-template-columns:100px minmax(0,1fr);gap:12px}.pv-model-dialog .pv-label{font-size:13px}.pv-model-dialog .pv-value{width:100%;max-width:none}.pv-model-dialog .pv-value>input{width:100%}.pv-required{color:var(--status-error);font-size:12px;margin-left:3px}.pv-model-purpose{display:flex;justify-content:space-between;gap:12px;padding:0 5px;font-size:13px}.pv-purpose-value{display:flex;flex-direction:column;gap:2px;text-align:right}.pv-purpose-value>.pv-helper{font-size:11px}.pv-more-settings{display:inline-flex;align-items:center;align-self:flex-start;gap:7px;padding:3px 5px;border:0;background:transparent;color:var(--surface-muted-foreground);font-size:12px}.pv-more-settings:hover{color:var(--surface-foreground)}.pv-capability-checkboxes{justify-content:flex-end;flex-wrap:wrap}.pv-model-dialog .pv-checkbox{font-size:11px}.pv-dialog-footer{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding-top:4px}.pv-sync-content{display:flex;flex-direction:column;gap:15px;min-height:0}.pv-sync-toolbar{display:flex;align-items:center;gap:8px}.pv-sync-toolbar>.pv-search{flex:1}.pv-sync-toolbar .pv-quiet{font-size:11px}.pv-sync-scroll{max-height:390px;overflow-y:auto;scrollbar-gutter:stable}.pv-sync-group+.pv-sync-group{margin-top:16px}.pv-sync-group h4{font-size:11px;font-weight:400;margin:0;padding:0 7px 8px;color:var(--surface-muted-foreground);display:flex;justify-content:space-between;gap:10px}.pv-sync-group h4>span{font-variant-numeric:tabular-nums}.pv-sync-row{display:flex;align-items:center;gap:9px;min-height:57px;padding:6px}.pv-sync-row+.pv-sync-row{border-top:1px solid var(--form-row-divider)}.pv-sync-model-name{flex:1;min-width:0;overflow-wrap:anywhere;font-size:13px;line-height:21px}.pv-sync-model-name>code{display:block;font-size:10px;line-height:16px;color:var(--surface-muted-foreground)}.pv-sync-row>.pv-capabilities{gap:5px}.pv-sync-added-label{font-size:10px;color:var(--surface-muted-foreground);min-width:30px;flex-shrink:0}.pv-sync-status{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:10px;border-top:1px solid var(--form-row-divider)}.pv-sync-status>.pv-helper{font-size:11px}.pv-sync-content .pv-dialog-footer{justify-content:space-between}.pv-sync-failure{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;padding:32px 15px}.pv-sync-failure>svg{color:var(--status-error)}.pv-sync-failure>strong{font-size:14px;font-weight:500}.pv-sync-failure>.pv-helper{max-width:340px}.pv.pv-phone-dialog{width:min(390px,calc(100vw - 24px));padding:20px}.pv-phone .pv-managed-row{gap:6px;padding-inline:10px}.pv-phone .pv-managed-name{font-size:12px}.pv-phone .pv-managed-row>.pv-capabilities{gap:3px}.pv-phone .pv-managed-row>.pv-capabilities>span{padding:4px;min-width:20px}.pv-phone .pv-model-actions{gap:0}.pv-phone .pv-managed-toolbar>select{width:96px}.pv-phone-dialog .pv-row{grid-template-columns:82px minmax(0,1fr);gap:8px}.pv-phone-dialog .pv-sync-row>.pv-capabilities{display:none}.pv-phone-dialog .pv-dialog-footer .pv-button,.pv-phone-dialog .pv-dialog-footer .pv-quiet,.pv-phone-dialog .