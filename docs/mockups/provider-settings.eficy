.pv-draft-model{display:grid;grid-template-columns:18px minmax(0,1fr) 70px 58px 28px;align-items:center;gap:10px;padding:11px 14px;min-height:64px}.pv-draft-model+.pv-draft-model{border-top:1px solid var(--form-row-divider)}.pv-added-check{color:var(--surface-muted-foreground)}.pv-draft-model .pv-model-name{width:100%}.pv-draft-model .pv-capabilities{justify-content:flex-end}.pv-model-editor{padding:14px;border-top:1px solid var(--form-row-divider)}.pv-subheading{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px}.pv-subheading .pv-helper{font-size:10px;margin-left:5px}.pv-model-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px 16px;margin-top:10px}.pv-model-form-grid>label{display:flex;flex-direction:column;gap:7px;font-size:12px}.pv-model-form-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:15px}.pv-checkbox{display:inline-flex;align-items:center;gap:6px;font-size:12px;cursor:pointer}.pv input[type=checkbox]{accent-color:var(--surface-foreground);height:14px;width:14px;margin:0;flex-shrink:0;cursor:pointer}.pv-model-editor .pv-error{margin-top:9px}.pv-discovery{padding:12px 14px 0;border-top:1px solid var(--form-row-divider)}.pv-discovery>.pv-search{margin:8px 0}.pv-discovery-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid var(--form-row-divider);font-size:12px}.pv-discovery-row code{font-size:11px;overflow-wrap:anywhere}.pv-fetch-error{display:flex;align-items:center;gap:10px;border-top:1px solid var(--form-row-divider);padding:14px}.pv-fetch-error>svg{color:var(--status-error)}.pv-fetch-error>div{flex:1}.pv-fetch-error p{font-size:12px}.pv-fetch-error .pv-helper{font-size:11px}.pv-config-section{border-top:1px solid var(--form-row-divider);padding-top:10px}.pv-config-trigger{width:100%;display:flex;align-items:center;gap:8px;border:0;background:transparent;padding:5px 3px;color:var(--surface-muted-foreground);font-size:12px;text-align:left}.pv-config-trigger:hover{color:var(--surface-foreground)}.pv-config-trigger>.pv-helper{margin-left:auto;font-size:10px}.pv-code{max-height:360px;overflow:auto;border:1px solid var(--form-surface-border);border-radius:12px;padding:15px;margin:12px 0 0;font-size:11px;line-height:19px;tab-size:2;color:var(--surface-muted-foreground);background:var(--surface-elevated);white-space:pre-wrap;overflow-wrap:anywhere}.pv-simulation-control{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:-5px}.pv-simulation-control .pv-helper{font-size:10px}.pv-error-box{padding:10px 12px;display:flex;align-items:center;gap:8px;background:var(--status-error-background);color:var(--status-error);font-size:12px;border-radius:10px}
.pv .pv-back-link{align-self:flex-start;padding-left:0;margin-top:-10px}.pv-auth-options{display:flex;gap:6px;align-self:flex-start}.pv .pv-auth-options .pv-chip{padding:0 12px}.pv-auth-content{padding:34px 24px;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center}.pv-auth-content h3{font-size:15px;font-weight:500}.pv-auth-content>.pv-helper{max-width:340px}.pv-auth-globe{color:var(--surface-muted-foreground);margin:3px 0 4px}.pv-auth-left{align-items:flex-start;text-align:left;padding:22px}.pv-auth-left>label{font-size:13px}.pv-auth-left>.pv-helper{max-width:none}.pv-success-icon{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:var(--status-success-background);color:var(--status-success)}.pv-waiting{display:flex;align-items:center;gap:7px;padding:7px 10px;font-size:12px}.pv-waiting>.pv-helper{font-size:10px;margin-left:5px}.pv-pending-dot{height:6px;width:6px;border-radius:50%;background:var(--status-warning)}.pv .pv-expire{font-size:10px;height:24px;min-height:24px}
